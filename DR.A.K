body{
    font-family: Arial, sans-serif;
    margin:0;
    padding:0;
    background:#f5f5f5;
    color:#333;
}

header{
    background:#0056b3;
    color:white;
    text-align:center;
    padding:20px;
}

main{
    max-width:900px;
    margin:20px auto;
    background:white;
    padding:20px;
    border-radius:8px;
}

h1,h2{
    margin-top:0;
}

ul{
    line-height:1.8;
}

footer{
    background:#222;
    color:white;
    text-align:center;
    padding:15px;
    margin-top:20px;
}
